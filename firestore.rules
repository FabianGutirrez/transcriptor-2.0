rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper for user data validation
    function isValidUser(data) {
      return data.keys().hasAll(['role', 'subscription', 'email']) &&
             data.role in ['Admin', 'Fonoaudiólogo'] &&
             data.subscription in ['Básico', 'Intermedio', 'Full'] &&
             data.email is string;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users shouldn't list all users
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && 
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['transcriptionCount', 'lastReset']) &&
                      request.resource.data.role == resource.data.role; // Role is immutable
    }

    match /patients/{patientId} {
      allow read: if isSignedIn() && resource.data.therapistId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.therapistId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.therapistId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.therapistId == request.auth.uid;
    }

    match /transcriptions/{transcriptionId} {
      allow read: if isSignedIn() && resource.data.therapistId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.therapistId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.therapistId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow read: if isSignedIn() && resource.data.therapistId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.therapistId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.therapistId == request.auth.uid;
    }
  }
}
